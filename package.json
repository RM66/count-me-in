{
  "name": "count-me-in",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:py": "turbo run test:py",
    "db:seed:demo": "bun --filter=web run db:seed:demo:py",
    "db:migrate:py": "bun --filter=web run db:migrate:py",
    "docs:api": "bun --filter=web run docs:api",
    "lint:py": "turbo run lint:py",
    "generate:openapi": "turbo run generate:openapi",
    "generate:constants": "turbo run generate:constants",
    "generate:py": "bun --filter=web run generate:py",
    "knip": "knip --exclude duplicates"
  },
  "devDependencies": {
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
