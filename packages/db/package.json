{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:demo": "bun --env-file=../../.env run src/seed/run-demo.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.0",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1"
  }
}
