# Copy to .env and adjust as needed. Matches docker-compose.yml defaults.
#
# apps/web is the only deployable app (Vercel). The job/queue layer is Upstash
# QStash: the web app publishes after the booking transaction commits and
# receives deliveries on POST /api/jobs/{queue}, where each job turns into one
# Telegram message. See docs/decisions/012-queue-upstash-qstash.md.

# Postgres (domain data)
POSTGRES_URL=postgresql://countmein:countmein@localhost:5432/countmein

# Redis (sessions, auth tickets, one-time login links, rate limits)
REDIS_URL=redis://localhost:6379

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public host — every link inside a notification is built from it, and QStash
# deliveries target `${APP_URL}/api/jobs/{queue}` (one-time cabinet login
# links, guest booking management links). No trailing slash.
# Note: QStash cannot reach localhost, so notifications only send end-to-end
# from a deployed URL (or a tunnel).
APP_URL=http://localhost:3000

# Telegram Bot Token (notifications + Login Widget)
# Get from @BotFather on Telegram
# Required for:
# - Sending booking notifications (QStash job handler)
# - Telegram Login Widget authentication (organizer login)
# To enable Login Widget, also run /setdomain command with @BotFather
#
# Note: a bot may only message users who have pressed Start on it. Recipients
# who never did are logged and skipped rather than retried.
TELEGRAM_BOT_TOKEN=

# Telegram Bot Username (for Login Widget)
# The username you set when creating the bot (without @)
# Example: if your bot is @countmein_bot, use: countmein_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Upstash QStash (job queue, ADR-012)
# From the QStash console (or the Upstash Vercel integration):
# - QSTASH_TOKEN publishes jobs; CI also uses it to keep the demo-refresh
#   QStash schedule in sync on production pushes (apps/web/scripts/ensure-qstash.ts)
# - QSTASH_URL matters when the instance is regional (e.g.
#   https://qstash-eu-central-1.upstash.io): without it the SDK defaults to
#   the global endpoint, which is not the one a regional token belongs to
# - the signing keys verify the `upstash-signature` header on
#     POST /api/jobs/{queue} deliveries
# Dev without a token: publishing is skipped with a warning.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# Cloudflare R2 (media storage for avatars and service photos)
# Get these from Cloudflare dashboard after creating an R2 bucket
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=countmein-media
R2_PUBLIC_BASE_URL=https://media.countmein.group

# ── Observability ──────────────────────────────────────────────
# Sentry — error monitoring + performance tracing (apps/web client + server).
# Get the DSN from Sentry project settings. Leave empty to disable.
SENTRY_DSN=
# Optional: for source-map upload during CI builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog Cloud — product analytics + feature flags + session replay.
# Both keys are the SAME "Project API key" (starts with phc_) from PostHog
# Project Settings — NOT the "Personal API key" (that's for the REST API).
# NEXT_PUBLIC_ prefix = inlined into the browser bundle (posthog-js).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Same Project API key, but server-only (no NEXT_PUBLIC_ prefix) — used by
# posthog-node for notification-sent events. Can be the same value as above.
POSTHOG_KEY=

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=
