# Copy to .env and adjust as needed. Matches docker-compose.yml defaults.

# Postgres (domain data + pg-boss)
DATABASE_URL=postgresql://countmein:countmein@localhost:5432/countmein

# Redis (sessions, OTP TTL, rate limits)
REDIS_URL=redis://localhost:6379

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public host (used to build cabinet deep links)
# APP_URL=http://localhost:3000

# Telegram Bot Token (messenger OTP + notifications + Login Widget)
# Get from @BotFather on Telegram
# Required for:
# - Sending OTP codes via Telegram
# - Sending booking notifications
# - Telegram Login Widget authentication (organizer login)
# To enable Login Widget, also run /setdomain command with @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram Bot Username (for Login Widget)
# The username you set when creating the bot (without @)
# Example: if your bot is @countmein_bot, use: countmein_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Cloudflare R2 (media storage for avatars and service photos)
# Get these from Cloudflare dashboard after creating an R2 bucket
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET=countmein-media
# R2_PUBLIC_BASE_URL=https://media.countmein.group
