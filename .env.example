# Copy to .env and adjust as needed. Matches docker-compose.yml defaults.
#
# apps/worker needs POSTGRES_URL, REDIS_URL, TELEGRAM_BOT_TOKEN and APP_URL —
# it checks all four at startup and refuses to boot without them, so a
# misconfigured deploy fails immediately instead of failing every job.

# Postgres (domain data + pg-boss)
POSTGRES_URL=postgresql://countmein:countmein@localhost:5432/countmein

# Redis (sessions, auth tickets, one-time login links, rate limits)
REDIS_URL=redis://localhost:6379

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public host — every link inside a notification is built from it
# (one-time cabinet login links, guest booking management links).
# Required by apps/worker; no trailing slash.
APP_URL=http://localhost:3000

# Telegram Bot Token (notifications + Login Widget)
# Get from @BotFather on Telegram
# Required for:
# - Sending booking notifications (apps/worker)
# - Telegram Login Widget authentication (organizer login)
# To enable Login Widget, also run /setdomain command with @BotFather
#
# Note: a bot may only message users who have pressed Start on it. Recipients
# who never did are logged and skipped rather than retried.
TELEGRAM_BOT_TOKEN=

# Telegram Bot Username (for Login Widget)
# The username you set when creating the bot (without @)
# Example: if your bot is @countmein_bot, use: countmein_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Cloudflare R2 (media storage for avatars and service photos)
# Get these from Cloudflare dashboard after creating an R2 bucket
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET=countmein-media
# R2_PUBLIC_BASE_URL=https://media.countmein.group

# ── Observability ──────────────────────────────────────────────
# Sentry — error monitoring + performance tracing (apps/web + apps/worker).
# Get the DSN from Sentry project settings. Leave empty to disable.
SENTRY_DSN=
# Optional: for source-map upload during CI builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog Cloud — product analytics + feature flags + session replay.
# Both keys are the SAME "Project API key" (starts with phc_) from PostHog
# Project Settings — NOT the "Personal API key" (that's for the REST API).
# NEXT_PUBLIC_ prefix = inlined into the browser bundle (posthog-js).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Same Project API key, but server-only (no NEXT_PUBLIC_ prefix) — used by
# posthog-node in apps/worker. Can be the same value as above.
POSTHOG_KEY=

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=