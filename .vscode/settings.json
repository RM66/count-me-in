{
  "npm.packageManager": "bun",
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/web/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/apps/web/api/_lib",
    "${workspaceFolder}/apps/web/api",
    "${workspaceFolder}/apps/web/tests_py",
    "${workspaceFolder}/apps/web"
  ],
  "python.analysis.exclude": ["**/__pycache__", "**/node_modules", "**/*_gen.py"]
}
