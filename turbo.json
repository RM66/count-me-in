{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "POSTGRES_URL",
    "REDIS_URL",
    "AUTH_SECRET",
    "APP_URL",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "R2_PUBLIC_BASE_URL",
    "TELEGRAM_BOT_TOKEN",
    "QSTASH_TOKEN",
    "QSTASH_URL",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",
    "NODE_ENV",
    "NEXT_RUNTIME",
    "CI",
    "CHECK",
    "DOCS_PORT",
    "SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "POSTHOG_KEY",
    "API_URL",
    "VERCEL",
    "VERCEL_ENV",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_TELEGRAM_BOT_USERNAME",
    "NEXT_PUBLIC_SITE_URL",
    "E2E_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "generate:openapi", "generate:constants", "generate:i18n:py"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/contracts/vectors/**"],
      "outputs": ["coverage/**"]
    },
    "test:py": {
      "dependsOn": ["generate:py"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "api/**",
        "tests_py/**",
        "pyproject.toml",
        "uv.lock",
        "requirements.txt"
      ],
      "outputs": []
    },
    "lint:py": {
      "dependsOn": ["generate:py"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "api/**",
        "tests_py/**",
        "pyproject.toml",
        "uv.lock",
        "requirements.txt"
      ],
      "outputs": []
    },
    "generate:py": {
      "dependsOn": [
        "generate:i18n:py",
        "generate:openapi",
        "generate:constants",
        "generate:rules",
        "generate:models"
      ],
      "inputs": [
        "$TURBO_ROOT$/packages/contracts/src/**/*.ts",
        "$TURBO_ROOT$/packages/translations/**",
        "scripts/**",
        "$TURBO_ROOT$/bun.lock"
      ],
      "outputs": [
        "api/_lib/countmein/contracts/models_gen.py",
        "api/_lib/countmein/contracts/constants_gen.py",
        "api/_lib/countmein/contracts/spec_gen.json",
        "api/_lib/countmein/validation/rules_gen.py",
        "api/_lib/countmein/i18n/translations_gen.py",
        "openapi.yaml"
      ]
    },
    "@repo/translations#test": {
      "outputs": []
    },
    "test:web": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "generate:i18n:py": {
      "inputs": [
        "$TURBO_ROOT$/packages/translations/**",
        "$TURBO_ROOT$/packages/contracts/src/**/*.ts",
        "scripts/generate-i18n-py.ts",
        "$TURBO_ROOT$/bun.lock"
      ],
      "outputs": ["api/_lib/countmein/i18n/translations_gen.py"]
    },
    "generate:openapi": {
      "inputs": [
        "$TURBO_ROOT$/packages/contracts/src/**/*.ts",
        "scripts/generate-openapi.ts",
        "$TURBO_ROOT$/bun.lock"
      ],
      "outputs": ["openapi.yaml", "api/_lib/countmein/contracts/spec_gen.json"]
    },
    "generate:rules": {
      "inputs": [
        "$TURBO_ROOT$/packages/contracts/src/**/*.ts",
        "scripts/generate-rules.ts",
        "$TURBO_ROOT$/bun.lock"
      ],
      "outputs": ["api/_lib/countmein/validation/rules_gen.py"]
    },
    "generate:models": {
      "dependsOn": ["generate:openapi"],
      "inputs": ["openapi.yaml", "scripts/generate-py-models.sh", "uv.lock"],
      "outputs": ["api/_lib/countmein/contracts/models_gen.py"]
    },
    "generate:constants": {
      "inputs": [
        "$TURBO_ROOT$/packages/contracts/src/**/*.ts",
        "scripts/generate-constants.ts",
        "$TURBO_ROOT$/bun.lock"
      ],
      "outputs": ["api/_lib/countmein/contracts/constants_gen.py"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
