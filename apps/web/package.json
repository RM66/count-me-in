{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"next dev --port 3000\" \"bun run dev:api:py\"",
    "dev:web": "next dev --port 3000",
    "build": "next build",
    "generate:py": "bun run generate:i18n:py && bun run generate:openapi && bun run generate:constants && bun run generate:rules && bun run generate:models",
    "generate:i18n:py": "bun scripts/generate-i18n-py.ts",
    "generate:constants": "bun scripts/generate-constants.ts",
    "generate:rules": "bun scripts/generate-rules.ts",
    "generate:models": "sh scripts/generate-py-models.sh",
    "generate:openapi": "bun scripts/generate-openapi.ts",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "NODE_ENV=development next typegen && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:api": "bun scripts/serve-api-docs.ts",
    "qstash:schedules": "bun scripts/ensure-qstash.ts",
    "test": "bun run test:web",
    "test:web": "vitest run",
    "test:py": "uv run pytest -n auto",
    "test:py:unit": "uv run pytest -m 'not integration'",
    "test:py:integration": "uv run pytest -m integration -n auto",
    "lint:py": "uv run ruff check . && uv run ruff format --check . && uv run mypy",
    "dev:api:py": "uv run uvicorn --app-dir api index:app --port ${PORT:-3001} --reload",
    "dev:api:py:ci": "uv run uvicorn --app-dir api index:app --port ${PORT:-3001}",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate:py": "uv run alembic upgrade head",
    "db:seed:demo:py": "PYTHONPATH=api/_lib uv run python -m countmein.db.seed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@repo/contracts": "workspace:*",
    "@repo/translations": "workspace:*",
    "@sentry/nextjs": "^11.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@telegram-auth/server": "^1.0.5",
    "@uiw/react-markdown-editor": "^6.1.4",
    "@upstash/qstash": "^2.12.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.435.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.5",
    "postgres": "^3.4.9",
    "shadcn": "^4.21.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
