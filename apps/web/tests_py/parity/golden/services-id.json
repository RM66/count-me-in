{
  "scenario": "services-id",
  "steps": [
    {
      "note": "seed a service with options; capture <serviceId>",
      "request": {
        "method": "POST",
        "path": "/api/services",
        "body": {
          "title": "Parity Service",
          "defaultPrice": "20.00",
          "defaultCapacity": 5,
          "defaultDurationMinutes": 45,
          "maxSeatsPerBooking": 4,
          "options": [
            "Option A"
          ],
          "optionsSelectMode": "single"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "permissions-policy": "camera=(), microphone=(), geolocation=()",
          "referrer-policy": "strict-origin-when-cross-origin",
          "strict-transport-security": "max-age=31536000; includeSubDomains",
          "vary": "Accept-Language",
          "x-content-type-options": "nosniff",
          "x-frame-options": "DENY",
          "x-robots-tag": "noindex"
        },
        "body": {
          "service": {
            "contact": null,
            "createdAt": "<ts:1>",
            "defaultCapacity": 5,
            "defaultDurationMinutes": 45,
            "defaultPrice": "20.00",
            "description": null,
            "id": "<sid:1>",
            "location": null,
            "maxSeatsPerBooking": 4,
            "options": [
              "Option A"
            ],
            "optionsSelectMode": "single",
            "organizerId": "<uuid:1>",
            "photoUrl": null,
            "title": "Parity Service"
          }
        },
        "body_raw": "{\"service\":{\"contact\":null,\"createdAt\":\"<ts:1>\",\"defaultCapacity\":5,\"defaultDurationMinutes\":45,\"defaultPrice\":\"20.00\",\"description\":null,\"id\":\"<sid:1>\",\"location\":null,\"maxSeatsPerBooking\":4,\"options\":[\"Option A\"],\"optionsSelectMode\":\"single\",\"organizerId\":\"<uuid:1>\",\"photoUrl\":null,\"title\":\"Parity Service\"}}",
        "contentLengthMatchesBody": true,
        "transferEncodingChunked": false
      },
      "sink": []
    },
    {
      "note": "get own service → 200",
      "request": {
        "method": "GET",
        "path": "/api/services/<serviceId>",
        "body": null
      },
      "response": {
        "status": 404,
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "permissions-policy": "camera=(), microphone=(), geolocation=()",
          "referrer-policy": "strict-origin-when-cross-origin",
          "strict-transport-security": "max-age=31536000; includeSubDomains",
          "vary": "Accept-Language",
          "x-content-type-options": "nosniff",
          "x-frame-options": "DENY",
          "x-robots-tag": "noindex"
        },
        "body": {
          "error": "Service not found"
        },
        "body_raw": "{\"error\":\"Service not found\"}",
        "contentLengthMatchesBody": true,
        "transferEncodingChunked": false
      },
      "sink": []
    },
    {
      "note": "unknown id → 404",
      "request": {
        "method": "GET",
        "path": "/api/services/<uuid:2>",
