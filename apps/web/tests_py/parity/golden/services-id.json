          "x-robots-tag": "noindex"
        },
        "body": {
          "slot": {
            "bookedCount": 0,
            "capacity": 2,
            "createdAt": "<ts:2>",
            "durationMinutes": 60,
            "id": "<uuid:3>",
            "price": null,
            "serviceId": "<sid:1>",
