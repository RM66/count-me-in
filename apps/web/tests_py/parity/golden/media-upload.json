{
  "scenario": "media-upload",
  "steps": [
    {
      "note": "happy path → 200 signed upload target (URL normalized)",
      "request": {
        "method": "POST",
        "path": "/api/organizers/me/avatar",
        "body": {
          "contentType": "image/png",
          "size": 1024
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "vary": "Accept-Language",
          "x-robots-tag": "noindex",
          "cache-control": "no-store",
          "x-content-type-options": "nosniff",
          "x-frame-options": "DENY",
          "referrer-policy": "strict-origin-when-cross-origin",
          "permissions-policy": "camera=(), microphone=(), geolocation=()",
          "strict-transport-security": "max-age=31536000; includeSubDomains"
        },
        "body": {
          "uploadUrl": "<presigned-url>",
          "publicUrl": "https://parity.r2.example/organizers/<uuid:1>/avatar-<media>.png",
          "expiresAt": "<ts:1>"
        },
        "body_raw": "<presigned-url>",
        "contentLengthMatchesBody": true,
        "transferEncodingChunked": false
      },
      "sink": []
    },
    {
      "note": "service photo happy path",
